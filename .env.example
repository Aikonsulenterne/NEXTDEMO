# Apify (henter rederiernes tracking-data)
APIFY_TOKEN=apify_api_...
APIFY_ACTOR_CMA=muhammetakkurtt/cma-cgm-cargo-tracking-scraper
APIFY_ACTOR_MSC=muhammetakkurtt/msc-cargo-tracking-scraper

# Anthropic (Claude læser data, hvis de ikke har den forventede form)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5

# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
SHEET_TAB_SHIPMENTS=Shipments
SHEET_TAB_LOG=Log

# Regler
DELAY_THRESHOLD_DAYS=1

# Demo: sekunder mellem hver række, der dukker op i arket
REVEAL_DELAY_SECONDS=1
